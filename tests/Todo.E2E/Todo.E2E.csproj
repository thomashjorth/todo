<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows, as the helper is: the Connections journey runs the real one, whose store encrypts
         with DPAPI. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Todo.TestSupport\Todo.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Todo.Helper\Todo.Helper.csproj" />
    <!-- The helper's own test host, linked rather than copied, so the two suites start it the same way. -->
    <Compile Include="..\Todo.Helper.Tests\RunningHelper.cs" Link="RunningHelper.cs" />
  </ItemGroup>
</Project>
