<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The helper on the PC: it holds the Jira and Azure DevOps tokens, opens the tunnel out to the host
       and makes the calls the host asks for. A web project for its local API on 127.0.0.1, which
       delivery 5's microfrontend talks to. Windows only in practice - the tokens are kept with DPAPI. -->
  <PropertyGroup>
    <RootNamespace>Todo.Helper</RootNamespace>
    <!-- Windows, said out loud rather than warned about four times: the tokens are kept with DPAPI,
         which only Windows has, and the helper runs on the user's Windows PC. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>2.0.0</Version>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <!-- The app's own bundle, built by scripts\build-web.ps1 into the host's wwwroot, carried inside the
       helper's exe: the Connections page is served from here and never from the NAS, because code from
       the NAS on the token's origin could read the token. A glob, so it is evaluated on every build and
       picks up the new hashed file names - but it is only as fresh as the last Angular build. -->
  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Todo.Host\wwwroot\**" Exclude="..\Todo.Host\wwwroot\.gitkeep;..\Todo.Host\wwwroot\prerendered-routes.json" LinkBase="wwwroot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Todo.Tunnel\Todo.Tunnel.csproj" />
  </ItemGroup>
</Project>
