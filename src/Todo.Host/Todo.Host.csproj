<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Todo.Host</RootNamespace>
    <!-- No OutputType: the Web SDK's default is a console exe, which is right for a server. It was
         WinExe while the app was a Photino window, so Windows would not open a terminal beside it. -->
    <ApplicationIcon>..\Todo.Web\public\favicon.ico</ApplicationIcon>
    <!-- /api/health prints this, so it is the one place a user can read which build is running - on
         the NAS too, where it says which image the scheduled task pulled. Major 2 is the web version;
         the desktop app's last number was 1.16.0, tagged v1.16.0. Without a version the answer was
         the assembly default, 1.0.0.0, which says only that nobody set one. -->
    <Version>2.0.0</Version>
  </PropertyGroup>
  <!-- Everything below is about the publish output. Measured 2026-08-20 on a self-contained
       single-file publish: 31 files, of which five beside the exe are not needed to run. -->
  <PropertyGroup>
    <!-- No web.config. It configures the ASP.NET Core Module in IIS, and this app runs on Kestrel
         alone - on this machine under Todo.cmd, and in a container on the NAS. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- No Todo.Host.staticwebassets.endpoints.json (55 kB). The manifest is read by
         MapStaticAssets; this app serves wwwroot through UseStaticFiles, which reads the file
         system. Measured removable: deleted from the output, / and /api/health and /scalar/ all
         still answered 200. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No .pdb files - one for this project, and one each for Todo.Core and Todo.Contracts, which
         travel as related files of a project reference and need the second property rather than
         the first. This is a trade-off, not tidying: without symbols a stack trace from the
         running app loses its line numbers. For one personal app on one machine, read by the
         person who can rebuild it with symbols in a minute, three files beat three line numbers.
         Release only, so debugging a Debug build is untouched - and dotnet test builds Debug. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The Angular build goes into the assembly rather than into a folder beside the exe. Slice 16
         chose one file, and wwwroot was the nine that were left after the five in Task 1.

         It also removes a difference nobody was testing. Until now the published exe read its
         frontend off disk relative to a content root, which is precisely the mechanism that made
         finding 5 a 404: the tests served from src\Todo.Host\wwwroot, the exe from its own folder,
         and only one of those two paths was ever exercised. Embedded, both serve the same bytes the
         same way, so an E2E run measures what the exe does.

         The cost, said out loud: a changed Angular file is now an input to the C# build. Angular has
         to be built before the host, and the host has to be rebuilt after. build-web.ps1 then
         dotnet test is that order, which is what Check.cmd already does, and MSBuild tracks
         EmbeddedResource timestamps so an incremental build notices. What it does not fix is the old
         trap: E2E still does not build Angular itself. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- .gitkeep keeps the folder in git before a build has happened and is not content.
         prerendered-routes.json is a note the Angular builder leaves for a prerendering step this
         app does not have; nothing requests it. Both would be dead weight inside the assembly.

         Update rather than Include for the CopyToPublishDirectory metadata: the Web SDK already has
         these files as Content, and a second Include would carry them twice. Never, because they
         are inside the exe now - left on, publish would write the same nine files beside it and the
         count would not have moved. -->
    <EmbeddedResource Include="wwwroot\**"
                      Exclude="wwwroot\.gitkeep;wwwroot\prerendered-routes.json" />
    <Content Update="wwwroot\**" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract travels inside the assembly, because the documentation page serves it itself.
         It sits in no build output, and RepoPaths only finds it by walking up to Todo.sln, which
         does not exist beside a published exe. A fixed LogicalName, so the resource name does not
         depend on the folder layout. -->
    <EmbeddedResource Include="..\..\contracts\openapi.yaml" LogicalName="Todo.Host.openapi.yaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ManifestEmbeddedFileProvider, which is what lets UseStaticFiles read the frontend out of
         the assembly instead of off disk. -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Todo.Contracts\Todo.Contracts.csproj" />
    <ProjectReference Include="..\Todo.Core\Todo.Core.csproj" />
    <ProjectReference Include="..\Todo.Tunnel\Todo.Tunnel.csproj" />
  </ItemGroup>
</Project>
