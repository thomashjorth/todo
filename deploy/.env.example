# Copy to .env beside docker-compose.yml on the NAS and fill in. .env is never committed.

# The NAS user and group that own /volume1/docker/todo/data. Read them with `id` in an SSH session
# as that user: uid=1026(thomas) gid=100(users) gives 1026 and 100.
TODO_UID=1026
TODO_GID=100

# The port the app answers on, on the NAS.
TODO_PORT=8080

# The hash of the app's password, made inside the container (docs/NAS.md). In SINGLE quotes: the hash
# is full of $ signs, and Compose reads $ in an unquoted or double-quoted value as a variable.
TODO_PASSWORD_HASH='pbkdf2-sha256$600000$...'

# The hash of the helper's key: "Make a new key" on the Connections page shows it, once. Single quotes
# for the same reason as above. Empty until the helper is paired.
TODO_HELPER_KEY_HASH=''
